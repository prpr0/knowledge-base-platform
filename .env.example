# 本地API进程通过SSH隧道访问虚拟机数据库；替换占位值，不提交真实凭证。
DATABASE_URL=postgresql+psycopg://<数据库用户>:<数据库密码>@127.0.0.1:15432/knowledge_base_platform
# 必填，至少32字节随机内容；缺失时启动明确失败。
JWT_SECRET=
# 可选，1至1440分钟，默认60。
TOKEN_MINUTES=60
# 本地通过SSH隧道连接虚拟机独立Redis；任务状态以PostgreSQL为准。
REDIS_URL=redis://127.0.0.1:16379/0
# 以下可选路径均为本机目录；默认相对于项目根，运行时不联网回退。
DATA_ROOT=./data
TOKENIZER_PATH=./models/qwen-tokenizer
EMBEDDING_MODEL_PATH=./models/bge-m3
RERANKER_MODEL_PATH=./models/bge-reranker-v2-m3
# 单文件最大字节数，默认50MiB。
MAX_UPLOAD_BYTES=52428800
# 默认正式微调模式；联调外部OpenAI兼容服务时显式改为external_api。
MODEL_MODE=finetuned
MODEL_BASE_URL=
MODEL_NAME=kb-grounded-qwen3-4b-v1
# 外部联调示例：MODEL_MODE=external_api、MODEL_BASE_URL=https://api.deepseek.com、MODEL_NAME=deepseek-flash。
# 仅在外部服务明确支持DeepSeek thinking参数时显式启用；默认不改变供应商行为。
MODEL_DISABLE_THINKING=false
# 可选服务密钥；绝不提交真实值。
MODEL_API_KEY=
MODEL_RELEASE_MANIFEST_PATH=
MODEL_CALIBRATION_MANIFEST_PATH=
# external_api不要求微调发布清单；校准报告可选，未提供时明确未校准，不伪造质量结论。
# 独立Fernet密钥；管理员写入模型密钥前必须由运行环境提供。
CONFIG_ENCRYPTION_KEY=
# FAQ聚类设计相似度，非校准置信度。
FAQ_CLUSTER_SIMILARITY=0.90
